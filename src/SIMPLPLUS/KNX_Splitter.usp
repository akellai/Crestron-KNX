#HELP_BEGIN
This SIMPL+ module acts as a string router or demultiplexer designed for a KNX control system. It filters incoming data strings and directs them to specific outputs based on predefined prefixes.

Here is the breakdown of its core functionality:

Input Processing: The module listens for incoming string data (up to 64 characters) on a single input named FROM_RX$. It ignores any string shorter than 2 characters.

Prefix Matching: It utilizes eight string parameters (G1 through G8) to define specific match criteria, which likely represent KNX group addresses or command headers. When a string is received, the module checks if it begins with the exact sequence defined in G1. If it doesn't, it checks G2, and so on.

Targeted Routing: If the beginning of the incoming string matches one of the parameters, the entire string is immediately routed to the corresponding output (KNX_RX1$ for G1, KNX_RX2$ for G2, etc.), and the evaluation stops.

Catch-All/Pass-Through: If the incoming string does not match any of the populated G1 through G8 parameters, it is sent to the TX$ output by default.


STRING_INPUT	_SKIP_;			STRING_OUTPUT	KNX_RX1$;
STRING_INPUT	_SKIP_;			STRING_OUTPUT	KNX_RX2$;
STRING_INPUT	_SKIP_;			STRING_OUTPUT	KNX_RX3$;
STRING_INPUT	_SKIP_;			STRING_OUTPUT	KNX_RX4$;
STRING_INPUT	_SKIP_;			STRING_OUTPUT	KNX_RX5$;
STRING_INPUT	_SKIP_;			STRING_OUTPUT	KNX_RX6$;
STRING_INPUT	_SKIP_;			STRING_OUTPUT	KNX_RX7$;
STRING_INPUT	_SKIP_;			STRING_OUTPUT	KNX_RX8$;
STRING_INPUT	FROM_RX$[64];		STRING_OUTPUT	TX$;

STRING_PARAMETER G1[12];
STRING_PARAMETER G2[12];
STRING_PARAMETER G3[12];
STRING_PARAMETER G4[12];
STRING_PARAMETER G5[12];
STRING_PARAMETER G6[12];
STRING_PARAMETER G7[12];
STRING_PARAMETER G8[12];

#BEGIN_PARAMETER_PROPERTIES G1
   propDefaultValue="";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES G2
   propDefaultValue="";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES G3
   propDefaultValue="";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES G4
   propDefaultValue="";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES G5
   propDefaultValue="";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES G6
   propDefaultValue="";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES G7
   propDefaultValue="";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES G8
   propDefaultValue="";
#END_PARAMETER_PROPERTIES

change FROM_RX$
{
	STRING from_rx[64];
	from_rx = FROM_RX$;

	if( len(from_rx)<2 )
		return;

	if( G1 <> "" )
	{
		if(Find(G1,from_rx) = 1)
		{
			KNX_RX1$ = from_rx;
			return;
		}
	}
	if( G2 <> "" )
	{
		if(Find(G2,from_rx) = 1)
		{
			KNX_RX2$ = from_rx;
			return;
		}
	}
	if( G3 <> "" )
	{
		if(Find(G3,from_rx) = 1)
		{
			KNX_RX3$ = from_rx;
			return;
		}
	}
	if( G4 <> "" )
	{
		if(Find(G4,from_rx) = 1)
		{
			KNX_RX4$ = from_rx;
			return;
		}
	}
	if( G5 <> "" )
	{
		if(Find(G5,from_rx) = 1)
		{
			KNX_RX5$ = from_rx;
			return;
		}
	}
	if( G6 <> "" )
	{
		if(Find(G6,from_rx) = 1)
		{
			KNX_RX6$ = from_rx;
			return;
		}
	}
	if( G7 <> "" )
	{
		if(Find(G7,from_rx) = 1)
		{
			KNX_RX7$ = from_rx;
			return;
		}
	}
	if( G8 <> "" )
	{
		if(Find(G8,from_rx) = 1)
		{
			KNX_RX8$ = from_rx;
			return;
		}
	}
	TX$ = from_rx;
}

Function Main()
{
	WaitForInitializationComplete();
}

