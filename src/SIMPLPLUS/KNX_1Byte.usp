#HELP_BEGIN
This SIMPL+ module is a parser designed for Crestron control systems to process incoming status messages from a KNX network. It listens for an 8-bit (1-byte) value associated with a specific KNX Group Address and translates that data into standard Crestron digital, analog, and string feedback signals.

**How it works:**

* **Filtering:** It monitors the `FROM_RX$` string input for messages that begin with the specified `GroupAddress` parameter followed by `:2:`.

* **Data Extraction:** If a matching prefix is found, it extracts the 2-character hexadecimal string immediately following it and converts it to a standard integer between 0 and 255.

* **Feedback Outputs:** It takes that extracted integer and updates four outputs accordingly:

* **On_FB (Digital):** Drives high if the value is greater than 0.

* **Off_FB (Digital):** Drives high if the value is exactly 0.

* **Val_FB (Analog):** Outputs the raw integer (0-255) as an analog level.

* **TextVal_FB (String):** Converts the 0-255 integer into a 0-100 percentage and outputs it as a formatted text string (e.g., "75%").
#HELP_END

/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT	_SKIP_;			DIGITAL_OUTPUT	_SKIP_;
STRING_INPUT 	FROM_RX$[64];	ANALOG_OUTPUT Val_FB;
DIGITAL_INPUT	_SKIP_;			DIGITAL_OUTPUT On_FB;
DIGITAL_INPUT	_SKIP_;			DIGITAL_OUTPUT Off_FB;
								STRING_OUTPUT TextVal_FB;

/*******************************************************************************************
  Parameters
  (Uncomment and declare parameters as needed)
*******************************************************************************************/
// INTEGER_PARAMETER
// SIGNED_INTEGER_PARAMETER
// LONG_INTEGER_PARAMETER
// SIGNED_LONG_INTEGER_PARAMETER
STRING_PARAMETER GroupAddress[9];

/*******************************************************************************************
  Parameter Properties
  (Uncomment and declare parameter properties as needed)
*******************************************************************************************/
#BEGIN_PARAMETER_PROPERTIES GroupAddress
   propDefaultValue="";
#END_PARAMETER_PROPERTIES

STRING Prefix[14];
INTEGER PrefixLen;

CHANGE FROM_RX$
{
	INTEGER pos;
	STRING from_rx[64];

	from_rx = FROM_RX$;
	if( len(from_rx)<PrefixLen+2 )
		return;
	pos = Find(Prefix,from_rx);
	if(pos = 1)
	{
		pos = HexToSI(mid(from_rx,PrefixLen+1,2));
		On_FB = pos;
		Off_FB = !pos;
		Val_FB = pos;
		pos = pos*100/255;
		TextVal_FB = itoa(pos) + "%";
	}	
}

/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/
Function Main()
{
    // TODO:  Add code here
    // Initialize declared global and local variables/arrays as needed.

    WaitForInitializationComplete();
	Prefix = GroupAddress + ":2:";
	PrefixLen = len(Prefix);
}

