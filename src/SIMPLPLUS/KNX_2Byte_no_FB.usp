#HELP_BEGIN
This SIMPL+ module encodes and transmits 2-byte floating-point analog values from a Crestron control system to a KNX network.

Here is how the module operates:

* **Data Conversion:** It takes a standard analog input (`Soll`), scales it by multiplying by 10, and converts it into a KNX-compatible 16-bit floating-point format. The module calculates the appropriate sign bit, exponent, and mantissa for the value.

* **Message Formatting:** The calculated 16-bit value is converted into a 4-character hexadecimal string. This hex value is appended to the user-defined `GroupAddress` parameter (formatted with a `:3:` prefix) and capped with a semicolon.

* **Conditional Transmission:** The module transmits the formatted command string out of the `To_KNX_TX$` output only when three specific digital inputs (`Trigger`, `Enable`, and `EnableGroup`) are all logically high simultaneously. If any of these three inputs are pushed (transition to high) while the other two are already high, the transmission is triggered.


/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT	_SKIP_;			DIGITAL_OUTPUT	_SKIP_;
DIGITAL_INPUT 	Enable;			STRING_OUTPUT To_KNX_TX$;
DIGITAL_INPUT	EnableGroup;	DIGITAL_OUTPUT _SKIP_;
DIGITAL_INPUT	Trigger;		DIGITAL_OUTPUT _SKIP_;
ANALOG_INPUT	Soll;			DIGITAL_OUTPUT _SKIP_;

/*******************************************************************************************
  Parameters
  (Uncomment and declare parameters as needed)
*******************************************************************************************/
// INTEGER_PARAMETER
// SIGNED_INTEGER_PARAMETER
// LONG_INTEGER_PARAMETER
// SIGNED_LONG_INTEGER_PARAMETER
STRING_PARAMETER GroupAddress[9];

/*******************************************************************************************
  Parameter Properties
  (Uncomment and declare parameter properties as needed)
*******************************************************************************************/
#BEGIN_PARAMETER_PROPERTIES GroupAddress
   propDefaultValue="";
#END_PARAMETER_PROPERTIES

STRING Prefix[14];
INTEGER PrefixLen;
 
Function Value()
{
  integer i, Exp, VZ;
  signed_integer Val;

  // Mantissa=1 
  Val = Soll * 10;

  Vz = 0;
  if( Val<0 )
  {
    Vz = 1;
    Val = 0x7FFF & Val;
  }
  
  Exp = 0;
  while( Val>=0x7FF )
  {
    Val = Val >> 1;
    Exp = Exp + 1;
  }
  Val = (VZ << 15) | (Exp << 11) | Val;

  makestring(To_KNX_TX$,"%s%04X;",Prefix,Val);
}

PUSH Trigger
{
	if( (Trigger = 1) & (Enable = 1) & (EnableGroup = 1))
		call Value();
}

PUSH Enable
{
	if( (Trigger = 1) & (Enable = 1) & (EnableGroup = 1))
		call Value();
}

PUSH EnableGroup
{
	if( (Trigger = 1) & (Enable = 1) & (EnableGroup = 1))
		call Value();
}

/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/
Function Main()
{
    // TODO:  Add code here
    // Initialize declared global and local variables/arrays as needed.

    WaitForInitializationComplete();
	Prefix = GroupAddress + ":3:";
	PrefixLen = len(Prefix);
}

