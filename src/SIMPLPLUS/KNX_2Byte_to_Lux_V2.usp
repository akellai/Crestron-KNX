ANALOG_INPUT   WORD_IN;

ANALOG_OUTPUT  LUX_INT;        // 0..65535
ANALOG_OUTPUT  LUX_X100_HI;    // 0..65535
ANALOG_OUTPUT  LUX_X100_LO;    // 0..65535
STRING_OUTPUT  LUX_TEXT$;      // set length in SIMPL Windows (e.g., 16)

/* locals */
LONG_INTEGER data, exp, mant, signv, pow2, ecount;
LONG_INTEGER scaled;           // exact lux*100 (can be negative before clamp)
LONG_INTEGER scaled_copy;

INTEGER out_hi, out_lo, whole, frac, out_lux;
INTEGER i, tmpA, addQ;

