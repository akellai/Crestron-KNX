CHANGE WORD_IN
{
    // 1) Read packed word
    data = WORD_IN;

    // 2) Extract fields without bitwise/shifts
    // sign bit = floor(data / 32768) (0 or 1)
    IF ( (data / 32768) >= 1 )  signv = -1;
    ELSE                        signv =  1;

    exp  = (data / 2048) MOD 16;   // bits14..11
    mant =  data MOD 2048;         // bits10..0 (UNSIGNED magnitude 0..2047)

    // 3) exact scaled value: lux*100 = sign * mant * 2^exp
    pow2 = 1;
    ecount = exp;
    WHILE (ecount > 0) { pow2 = pow2 * 2; ecount = ecount - 1; }
    scaled = signv * mant * pow2;

    // Illuminance cannot be negative ¡÷ clamp to zero
    IF (scaled < 0) { scaled = 0; }

    // 4) Split lux*100 into HI/LO words (no bitwise)
    scaled_copy = scaled;
    out_hi = 0;
    WHILE (scaled_copy >= 65536) {
        scaled_copy = scaled_copy - 65536;
        out_hi = out_hi + 1;
        IF (out_hi > 65535) { out_hi = 65535; }  // saturate
    }
    out_lo = 0;
    WHILE (scaled_copy > 0) {
        scaled_copy = scaled_copy - 1;
        out_lo = out_lo + 1;
        IF (out_lo > 65535) { out_lo = 65535; }
    }
    LUX_X100_HI = out_hi;
    LUX_X100_LO = out_lo;

    // 5) Compute whole/frac from HI/LO only (avoid LONG¡÷INTEGER narrows)
    // scaled / 100 = out_hi*655 + floor((out_hi*36 + out_lo)/100)
    whole = 0;
    i = 0; WHILE (i < out_hi) { whole = whole + 600; i = i + 1; }
    i = 0; WHILE (i < out_hi) { whole = whole + 55;  i = i + 1; }

    tmpA = 0;  // tmpA = out_hi*36 + out_lo
    i = 0; WHILE (i < out_hi) { tmpA = tmpA + 36; i = i + 1; }
    tmpA = tmpA + out_lo;

    addQ = 0;  // addQ = floor(tmpA/100)
    WHILE (tmpA >= 100) { tmpA = tmpA - 100; addQ = addQ + 1; }

    whole = whole + addQ;
    frac  = tmpA;            // 0..99

    // 6) Text "xxxx.xx"
    IF (frac < 10)
        LUX_TEXT$ = Itoa(whole) + ".0" + Itoa(frac);
    ELSE
        LUX_TEXT$ = Itoa(whole) + "." + Itoa(frac);

    // 7) Rounded lux: (scaled + 50) / 100  ¡÷  whole + (frac>=50 ? 1:0)
    out_lux = whole;
    IF (frac >= 50) { IF (out_lux < 65535) { out_lux = out_lux + 1; } }
    LUX_INT = out_lux;
}

