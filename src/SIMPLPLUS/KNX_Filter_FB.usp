#ENABLE_TRACE
// #ENCODING_ASCII
// #ENCODING_UTF16
// #ENCODING_INHERIT_FROM_PARENT
// #ENCODING_INHERIT_FROM_PROGRAM
#HELP_BEGIN
This SIMPL+ module acts as a string filter and digital routing interface for incoming KNX network messages. It compares an incoming data string against a list of up to 200 user-defined group parameters and triggers corresponding digital logic while passing unmatched messages down the line.

Here is a breakdown of how the module operates:

* **Initialization:** Upon startup, the module checks how many of the 200 possible `out_fb` digital outputs are actively defined in the Crestron program to optimize its processing loop.

* **String Matching:** When a message arrives at the `FROM_RX$` input, the module loops through the configured `Group` parameters. It checks if the incoming message begins with any of those defined group strings.

* **Digital Output & Interlocking:** If a match is found, it drives the corresponding `out_fb` digital output high (1). It also applies a mutually exclusive interlocking logic to paired outputs: triggering an even-numbered output forces the preceding odd-numbered output low (0), and triggering an odd-numbered output forces the subsequent even-numbered output low (0).

* **Passthrough Routing:** Once a match is found, it stops evaluating the string. If the module loops through all defined parameters without finding a match, it routes the untouched incoming string to the `FILTERED_RX$` output so it can be handled by other modules.
#HELP_END

STRING_INPUT	FROM_RX$[64];		STRING_OUTPUT FILTERED_RX$;
STRING_PARAMETER _SKIP_;			DIGITAL_OUTPUT _SKIP_;
STRING_PARAMETER Group[200,1][32];	DIGITAL_OUTPUT out_fb[200,1];

#BEGIN_PARAMETER_PROPERTIES Group
   propDefaultValue="";
#END_PARAMETER_PROPERTIES

INTEGER NumInputs;

change FROM_RX$
{
	integer i;
	string Slocal[64];

	Slocal = FROM_RX$;
	if( len(Slocal)<1 )
	return;

	for( i=1 to NumInputs step 1 )
	{	
		if( Group[i] <> "" )
		{
			if(Find(Group[i],Slocal) = 1)
			{
				out_fb[i] = 1;
				if( i%2 = 0 )
					out_fb[i-1] = 0;
				else if( i+1 <= NumInputs )
					out_fb[i+1] = 0;
				return;
			}
		}
	}
	FILTERED_RX$ = Slocal;
}

Function Main()
{
	WaitForInitializationComplete();

	for(NumInputs = 200 to 1 Step -1)
		if(IsSignalDefined(out_fb[NumInputs]))
			Break;
}

