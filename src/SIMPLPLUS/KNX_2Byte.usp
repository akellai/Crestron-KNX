#HELP_BEGIN
This SIMPL+ module parses 2-byte (16-bit) floating-point data from a KNX network. It is specifically designed to decode KNX 2-byte floating-point values (like temperature or sensor readings) into standard signed integers.

Here is how it processes the data:

* **Message Filtering:** It monitors the `FROM_RX$` string input for messages that begin with the specified `GroupAddress` parameter followed by `:3:`.

* **Raw Data Extraction:** When a matching message is found, it extracts the 4-character hexadecimal string immediately following the prefix, converts it to an integer, and sends this raw value to the `Val_FB` analog output.

* **Floating-Point Decoding:** It passes the 16-bit integer into a decoding function (`getVal`) that separates the data into its core components: a sign bit, a 4-bit exponent, and an 11-bit mantissa. If the value is negative, it applies two's complement logic to the mantissa.

* **Value Scaling:** It applies the exponent to the mantissa and adjusts the final numerical value based on the user-defined `Mantissa` parameter to scale the decimal precision appropriately.

* **Signed Output:** It caps the absolute value at 32767, applies the appropriate positive or negative sign, and sends the final calculated integer to the `Signed_Analog_Value` analog output.


/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT	_SKIP_;			DIGITAL_OUTPUT	_SKIP_;
DIGITAL_INPUT	_SKIP_;			DIGITAL_OUTPUT	_SKIP_;
STRING_INPUT 	FROM_RX$[64];	ANALOG_OUTPUT Val_FB;
DIGITAL_INPUT	_SKIP_;			ANALOG_OUTPUT Signed_Analog_Value;

/*******************************************************************************************
  Parameters
  (Uncomment and declare parameters as needed)
*******************************************************************************************/
// INTEGER_PARAMETER
// SIGNED_INTEGER_PARAMETER
// LONG_INTEGER_PARAMETER
// SIGNED_LONG_INTEGER_PARAMETER
STRING_PARAMETER GroupAddress[9];
SIGNED_INTEGER_PARAMETER Mantissa;

/*******************************************************************************************
  Parameter Properties
  (Uncomment and declare parameter properties as needed)
*******************************************************************************************/
#BEGIN_PARAMETER_PROPERTIES GroupAddress
   propDefaultValue="";
#END_PARAMETER_PROPERTIES
#BEGIN_PARAMETER_PROPERTIES Mantissa
   propDefaultValue=1d;
#END_PARAMETER_PROPERTIES

STRING Prefix[12];
INTEGER PrefixLen;

function getVal(integer Value_2Byte)
{
	integer VZ, Exp, Man, C, S;
	long_integer lout;
	signed_integer siout;


	VZ = Value_2Byte >> 15;           // plus/minus sign
	Exp = (Value_2Byte >> 11) & 0x0F; // exponent
	Man = Value_2Byte & 0x7FF;        // mantissa
	if (VZ)	
	{
		Man = NOT (Man);		  // 1st complement wenn neg value
		Man = Man & 0x7FF;
	}

	Man = Man << Exp; 				// Exp times (<= 15)

	if (Mantissa = 1)
	{
  		Man = (Man+5)/10;
	}
	if (Mantissa = 0)
	{
  		Man = (Man+49)/100; 
	}
	if (Mantissa >= 2)
	{	
  		Man = Man*10^(Mantissa-2);  
	}

  	lout = Man;  
  	//print("%ld\n",lout);

  	if(lout > 32767)
		lout = 32767;
  	if(VZ)
    	siout = lout * (-1);         
  	else
    	siout = lout;
  	Signed_Analog_Value = siout;
}

CHANGE FROM_RX$
{
	integer Pos;
	STRING from_rx[64];
	from_rx = FROM_RX$;

	pos = Find(Prefix,from_rx);
	if(pos = 1)
	{
		pos = HexToSI(mid(from_rx,PrefixLen+1,4));
		Val_FB = pos;
		call getVal(pos);
	}
}

