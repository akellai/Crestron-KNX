#HELP_BEGIN
This SIMPL+ module functions as a bidirectional interface between a Crestron system and a KNX network, specifically handling analog (1-byte) values.

Here is how the module operates:

* **Receiving Data (Feedback):** It monitors the `FROM_RX$` input for messages starting with the defined `GroupAddress` parameter followed by `:2:`. When a matching message is received, it extracts the 2-character hexadecimal value following the prefix, converts it into an integer, and sends it to the `Val_fb` analog output.

* **Transmitting Data (Control):** When the `Val_tp` analog input changes (typically driven by a touch panel or logic), the module converts that integer into a 2-character hexadecimal string. It appends this hex value to the group address prefix, adds a closing semicolon, and transmits the resulting string out the `To_KNX_TX$` output to send a command to the KNX network.
#HELP_END


/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT	_SKIP_;			DIGITAL_OUTPUT	_SKIP_;
STRING_INPUT 	FROM_RX$[64];	STRING_OUTPUT To_KNX_TX$;
ANALOG_INPUT 	Val_tp;			ANALOG_OUTPUT Val_fb;

/*******************************************************************************************
  Parameters
  (Uncomment and declare parameters as needed)
*******************************************************************************************/
// INTEGER_PARAMETER
// SIGNED_INTEGER_PARAMETER
// LONG_INTEGER_PARAMETER
// SIGNED_LONG_INTEGER_PARAMETER
STRING_PARAMETER GroupAddress[9];

/*******************************************************************************************
  Parameter Properties
  (Uncomment and declare parameter properties as needed)
*******************************************************************************************/
#BEGIN_PARAMETER_PROPERTIES GroupAddress
   propDefaultValue="";
#END_PARAMETER_PROPERTIES

STRING Prefix[12];
INTEGER PrefixLen;

CHANGE FROM_RX$
{
	INTEGER pos;
	STRING from_rx[64];

	from_rx = FROM_RX$;

	pos = Find(Prefix,from_rx);
	if(pos = 1)
	{
		pos = HexToSI(mid(from_rx,PrefixLen+1,2));
		Val_fb = pos;
	}	
}

CHANGE Val_tp
{
	makestring(To_KNX_TX$,"%s%02X;",Prefix,Val_tp);
}

/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/
Function Main()
{
    // TODO:  Add code here
    // Initialize declared global and local variables/arrays as needed.

    WaitForInitializationComplete();
	Prefix = GroupAddress + ":2:";
	PrefixLen = len(Prefix);
}

